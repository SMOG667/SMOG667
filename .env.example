# PostgreSQL — Neon (pooler obligatoire pour serverless Vercel)
# Format Neon : ajouter `?sslmode=require&pgbouncer=true&connect_timeout=15`
# Utiliser l'URL "Pooled connection" fournie par Neon (endpoint -pooler)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/btp?sslmode=require&pgbouncer=true&connect_timeout=15"

# URL directe (sans pooler) — requise pour les migrations Prisma
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/btp?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Entreprise (valeurs par défaut, remplaçables via l'UI)
ENTREPRISE_NOM="Mon Entreprise BTP SARL"
ENTREPRISE_RCCM=""
ENTREPRISE_NCC=""
ENTREPRISE_REGIME_FISCAL="RNI"

# OCR factures (Anthropic Claude API)
ANTHROPIC_API_KEY=""
